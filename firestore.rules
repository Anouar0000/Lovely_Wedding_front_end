rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function emailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Keep in sync with REACT_APP_ADMIN_EMAILS / src/services/users.js
    function isAdminEmail() {
      return isSignedIn()
        && emailVerified()
        && request.auth.token.email in [
          'mkadmiaziz0203@gmail.com',
          'benhamzaanouar000@gmail.com',
          'azza.setti@gmail.com',
          'houssemsetties@gmail.com'
        ];
    }

    // Admin authority = verified allowlist only (not stale Firestore role alone)
    function isAdmin() {
      return isAdminEmail();
    }

    // Same mailbox → same key. Keep in sync with canonicalEmail() in src/lib/authSecurity.js
    function canonicalEmail(email) {
      let parts = email.lower().split('@');
      let local = parts[0].split('[+]')[0];
      let domain = parts[1];
      return domain in ['gmail.com', 'googlemail.com']
        ? local.replace('[.]', '') + '@gmail.com'
        : local + '@' + domain;
    }

    function verifiedEmailIs(email) {
      return emailVerified()
        && email is string
        && email.lower() == request.auth.token.email.lower();
    }

    function inviteDoc(inviteId) {
      return get(/databases/$(database)/documents/digitalInvites/$(inviteId)).data;
    }

    function validOrderStatus(status) {
      return status in ['pending_payment', 'paid', 'fulfilled', 'cancelled'];
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'role', 'fullName', 'phone', 'createdAt', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['client', 'admin']
        && (request.resource.data.role == 'client' || isAdminEmail());

      // Clients may only edit their contact info; role/notes stay admin-managed.
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'updatedAt'])
        )
        || (
          isOwner(userId)
          && isAdminEmail()
          && request.resource.data.role == 'admin'
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'email', 'fullName', 'phone', 'updatedAt'])
        );

      allow delete: if isAdmin();
    }

    // One account per mailbox: doc id = canonical email, held by a single uid.
    match /emailIndex/{emailKey} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn()
        && request.auth.token.email is string
        && emailKey == canonicalEmail(request.auth.token.email)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;

      // Re-claim by the same uid is a no-op; another uid can never take it over.
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;

      allow delete: if isAdmin();
    }

    match /digitalInvites/{inviteId} {
      allow read: if resource.data.status == 'published'
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || (isSignedIn() && resource.data.clientUserId == request.auth.uid)
        || verifiedEmailIs(resource.data.clientEmail)
        || isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['ownerId', 'status', 'slug']);

      allow update: if isAdmin()
        || (isOwner(resource.data.ownerId)
          && request.resource.data.ownerId == resource.data.ownerId);

      allow delete: if isAdmin() || isOwner(resource.data.ownerId);
    }

    // Orders: client create allowed on Spark.
    // After Blaze: deploy createOrder function, set REACT_APP_SERVER_ORDERS=true,
    // then flip to `allow create: if false`.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['status', 'items', 'customer', 'totals'])
        && request.resource.data.status == 'pending_payment'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.customer.keys().hasAll(['fullName', 'email', 'phone'])
        && request.resource.data.customer.fullName is string
        && request.resource.data.customer.fullName.size() > 0
        && request.resource.data.customer.fullName.size() <= 120
        && request.resource.data.customer.email is string
        && request.resource.data.customer.email.size() <= 200
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() <= 40
        && (
          !('userId' in request.resource.data)
          || request.resource.data.userId == null
          || (isSignedIn() && request.resource.data.userId == request.auth.uid)
        );

      // Guest orders (userId null): ID acts as secret. Owned orders: owner/admin only.
      allow get: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || resource.data.userId == null;

      allow list: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow update: if isAdmin()
        && validOrderStatus(request.resource.data.status);

      allow delete: if isAdmin();
    }

    match /catalogProducts/{productId} {
      allow read: if resource.data.active == true || isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['type', 'name', 'active'])
        && request.resource.data.type in ['digital', 'physical']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;

      allow update, delete: if isAdmin();
    }

    // Digital pack / extra / section prices — public read, admin write.
    match /pricing/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && docId in ['digital']
        && request.resource.data.keys().hasOnly(['packs', 'extras', 'sections', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /rsvpResponses/{responseId} {
      allow create: if request.resource.data.keys().hasAll(['inviteId', 'ownerId', 'fullName'])
        && request.resource.data.inviteId is string
        && request.resource.data.inviteId.size() > 0
        && request.resource.data.inviteId.size() <= 128
        && request.resource.data.ownerId is string
        && request.resource.data.ownerId.size() > 0
        && request.resource.data.ownerId.size() <= 128
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && (!('email' in request.resource.data)
          || (request.resource.data.email is string && request.resource.data.email.size() <= 200))
        && (!('phone' in request.resource.data)
          || (request.resource.data.phone is string && request.resource.data.phone.size() <= 40))
        && (!('guestCount' in request.resource.data)
          || (request.resource.data.guestCount is number
            && request.resource.data.guestCount >= 1
            && request.resource.data.guestCount <= 50))
        && inviteDoc(request.resource.data.inviteId).status == 'published'
        && request.resource.data.ownerId == inviteDoc(request.resource.data.inviteId).ownerId
        && (
          !('clientUserId' in request.resource.data)
          || request.resource.data.clientUserId == ''
          || request.resource.data.clientUserId == inviteDoc(request.resource.data.inviteId).clientUserId
        )
        && (
          !('clientEmail' in request.resource.data)
          || request.resource.data.clientEmail == ''
          || request.resource.data.clientEmail == inviteDoc(request.resource.data.inviteId).clientEmail
        );

      allow read: if isSignedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || resource.data.clientUserId == request.auth.uid
          || verifiedEmailIs(resource.data.clientEmail)
          || isAdmin()
        );

      allow update, delete: if false;
    }

    // Append-only security audit trail (client best-effort; admin read).
    match /securityEvents/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['type', 'details', 'createdAt', 'userAgent'])
        && request.resource.data.type is string
        && request.resource.data.type in [
          'admin_login',
          'admin_mfa_missing',
          'admin_mfa_ok',
          'order_create_client',
          'auth_email_taken',
          'auth_lockout'
        ]
        && request.resource.data.details is map
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 300;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
