REACT_APP_UNSAFE_ZONE_EDITOR=false

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Emails admin separes par des virgules (acces dashboard edition)
REACT_APP_ADMIN_EMAILS=admin@lovelywedding.com

# Set to true only after Cloud Functions are deployed with Flouci secrets
REACT_APP_FLOUCI_LIVE=false

# After Blaze + firebase deploy --only functions: set true for server-priced orders
REACT_APP_SERVER_ORDERS=false

# App Check — reCAPTCHA v3 site key (Firebase Console → App Check)
REACT_APP_RECAPTCHA_SITE_KEY=
# Optional debug token for local App Check
REACT_APP_APPCHECK_DEBUG_TOKEN=

# Require enrolled MFA for admin dashboard (needs Identity Platform)
REACT_APP_REQUIRE_ADMIN_MFA=false
